all:
prefix=c:/QEMU
bindir=${prefix}
libdir=${prefix}/lib
libexecdir=${prefix}/libexec
includedir=${prefix}/include
mandir=${prefix}
sysconfdir=${prefix}
qemu_confdir=${prefix}
qemu_datadir=${prefix}
qemu_firmwarepath=${prefix}/share/qemu-firmware
qemu_docdir=${prefix}
qemu_moddir=${prefix}/lib
qemu_helperdir=${prefix}/libexec
qemu_localedir=${prefix}/locale
qemu_icondir=${prefix}/icons
qemu_desktopdir=${prefix}/applications
libs_cpu=-LD:/msys64/mingw64/lib -lcapstone 
libs_softmmu=-LD:/msys64/mingw64/lib -lpixman-1 -LD:/msys64/mingw64/lib -lpng16 -lz  -lglfw3 -lopengl32  
GIT=git
GIT_SUBMODULES=ui/keycodemapdb tests/fp/berkeley-testfloat-3 tests/fp/berkeley-softfloat-3 slirp
GIT_UPDATE=yes
ARCH=x86_64
CONFIG_MINIKCONF_MODE=--defconfig
STRIP=x86_64-w64-mingw32-strip
CONFIG_WIN32=y
CONFIG_FILEVERSION=5,0,50,0
CONFIG_PRODUCTVERSION=5,0,50,0
CONFIG_QGA_NTDDSCSI=y
CONFIG_TOOLS=y
CONFIG_SLIRP=y
CONFIG_SMBD_COMMAND="/usr/sbin/smbd"
SLIRP_CFLAGS=-I$(SRC_PATH)/slirp/src -I$(BUILD_DIR)/slirp/src
SLIRP_LIBS=-L$(BUILD_DIR)/slirp -lslirp -lws2_32 -liphlpapi
config-host.h: slirp/all
CONFIG_AUDIO_DRIVERS=dsound
CONFIG_AUDIO_DSOUND=y
ALSA_LIBS=
PULSE_LIBS=
COREAUDIO_LIBS=
DSOUND_LIBS=-lole32 -ldxguid
OSS_LIBS=
JACK_LIBS=
CONFIG_AUDIO_WIN_INT=y
CONFIG_BDRV_RW_WHITELIST=
CONFIG_BDRV_RO_WHITELIST=
CONFIG_VNC=y
CONFIG_VNC_PNG=y
VERSION=5.0.50
PKGVERSION=
SRC_PATH=/d/qemu5.0
TARGET_DIRS=x86_64-softmmu
CONFIG_SDL=m
SDL_CFLAGS=-Dmain=SDL_main -ID:/msys64/mingw64/include/SDL2 -Wno-undef
SDL_LIBS=-LD:/msys64/mingw64/lib -lmingw32 -lSDL2main -lSDL2 -mwindows
CONFIG_ICONV=y
ICONV_CFLAGS=-I/usr/local/include
ICONV_LIBS=-L/usr/local/lib -liconv
CONFIG_GIO=y
GIO_CFLAGS=-pthread -mms-bitfields -ID:/msys64/mingw64/include -ID:/msys64/mingw64/include/glib-2.0 -ID:/msys64/mingw64/lib/glib-2.0/include -ID:/msys64/mingw64/include
GIO_LIBS=-LD:/msys64/mingw64/lib -lgio-2.0 -lgobject-2.0 -lglib-2.0 -lintl
GDBUS_CODEGEN=D:/msys64/mingw64/bin/gdbus-codegen
CONFIG_TLS_PRIORITY="NORMAL"
CONFIG_QEMU_PRIVATE_XTS=y
CONFIG_TASN1=y
INSTALL_BLOBS=yes
CONFIG_TCG=y
CONFIG_AVX2_OPT=y
CONFIG_BZIP2=y
