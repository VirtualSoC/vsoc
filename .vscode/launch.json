        {
            "name": "Launch-qemu-image",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "x64",
            "program": "${workspaceFolder}/../../bin/qemu-system-x86_64.exe",
            "args": [
                "-accel", "whpx,kernel-irqchip=off",
                "-cpu", "android64",
                "-m", "4096",
                "-smp", "4",
                "-machine", "usb=on",
                "-device", "usb-kbd",
                "-device", "usb-tablet",
                "-boot", "menu=on",
                "-device", "intel-hda",
                "-device", "hda-duplex",
                "-netdev", "user,id=cell",
                "-device", "virtio-net-pci,netdev=cell",
                "-netdev", "user,id=wlan",
                "-device", "virtio-net-pci,netdev=wlan",
                "-kernel", "${workspaceFolder}/../../img/pie-x86/kernel",
                "-append", "nokaslr no_timer_check earlycon=pl011,0x9000000 console=ttyS0 RAMDISK=vdb DATA=vdc video=3840x2160 ramoops.mem_address=0x11ff000000 ramoops.mem_size=0x1000000 pstore.backend=ramoops",
                "-initrd", "${workspaceFolder}/../../img/pie-x86/initrd.img",
                "-drive", "index=0,if=virtio,id=system,file=${workspaceFolder}/../../img/pie-x86/system.qcow2,format=qcow2",
                "-drive", "index=1,if=virtio,id=ramdisk,file=${workspaceFolder}/../../img/pie-x86/ramdisk.qcow2,format=qcow2",
                "-drive", "index=2,if=virtio,id=userdata,file=${workspaceFolder}/../../img/pie-x86/userdata.qcow2,format=qcow2",
                "-device", "teleport,touchscreen=on,codec=off,keep_window_scale=on,independ_window=off,gl=on,bridge=off,gl_debug=off,gl_log_level=1,gl_log_to_host=on,opengl_trace=off,device_input_window=off",
