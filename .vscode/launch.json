
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Android-x86 Snapshot",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "x86_64",
            "program": "${workspaceFolder}/../../bin/qemu-system-x86_64.exe",
            "args": [
                // "-accel", "tcg",
                "-accel", "whpx,kernel-irqchip=off",
                "-cpu", "android64",
                "-m", "8192",
                "-smp", "8",
                "-machine", "usb=on",
                "-device", "usb-kbd",
                "-device", "usb-tablet",
                "-boot", "menu=on",
                "-device", "intel-hda",
                "-device", "hda-duplex",
                "-net", "nic",
                "-net", "user,hostfwd=tcp::5555-:5555",
                "-display", "sdl",
                "-hda", "${workspaceFolder}/../../img/x86hda.qcow2",
                "-cdrom", "${workspaceFolder}/../../img/android-x86_64-9.0-r2.iso",
                "-serial", "stdio",
                "-monitor", "tcp::4444,server,nowait",
                // "-device", "teleport,gl_debug=off,gl_log_level=1,device_input_window=off,battery=off,codec=off,accel=off,gyro=off,display_height=2160,display_width=3840,mic=off,keyboard=off,gps=off,camera=off"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/../../bin",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb-multiarch.exe"
         },
         {
            "name": "Launch-iso",
