        {
            "name": "Launch-bliss-image",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "x64",
            "program": "${workspaceFolder}/../../bin/qemu-system-x86_64.exe",
            "args": [
                "-accel", "whpx,kernel-irqchip=off",
                "-cpu", "android64",
                "-m", "4096",
                "-smp", "8",
                "-machine", "usb=on",
                "-device", "intel-hda",
                "-device", "hda-duplex",
                "-kernel", "${workspaceFolder}/../../img/bliss/kernel",
                "-append", "nokaslr no_timer_check initrd=/initrd.img root=/dev/ram0 DATA=vdb console=ttyS0 DEBUG=0 quiet",
                "-initrd", "${workspaceFolder}/../../img/bliss/initrd.img",
                "-drive", "index=0,if=virtio,id=system,file=${workspaceFolder}/../../img/bliss/system.qcow2,format=qcow2",
                "-drive", "index=1,if=virtio,id=userdata,file=${workspaceFolder}/../../img/bliss/userdata.qcow2,format=qcow2",
                "-display", "sdl",
                "-device", "teleport,gl_debug=off,gl_log_level=0,display_width=1920,display_height=1080,refresh_rate=60",
                "-serial", "stdio",
                "-netdev", "user,id=cell",
                "-device", "virtio-net-pci,netdev=cell",
                "-netdev", "user,id=wlan",
                "-device", "virtio-net-pci,netdev=wlan",
                "-monitor", "tcp::44444,server,nowait"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/../../bin",
            "MIMode": "gdb",
